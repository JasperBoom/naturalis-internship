<tool
  id="fastq-to-fasta"
  name="FASTQ to FASTA"
  version="0.1.0"
  profile="25.0"
>
<!-- Copyright 2025-2026 Jasper Boom. All rights reserved. See LICENSE.md. -->

  <!-- General description of the tool. -->
  <description>
    Convert FASTQ reads to FASTA.
  </description>

  <!-- Creator and maintainer of this tool XML file. -->
  <creator>
    <person
      givenName="Jasper"
      familyName="Boom"
      jobTitle="Bioinformatics Engineer"
      email="contact@boom.frl"
    />
    <organization
      url="https://www.naturalis.nl"
      name="Naturalis Biodiversity Center"
    />
  </creator>

  <!-- EDAM (EMBRACE Data and Methods) is a standardised ontology of
    bioinformatics operations, data types, formats, and topics used to
    categorise the tool by its scientific domain or topic using standardised
    identifiers from the EDAM ontology
    https://bioportal.bioontology.org/ontologies/EDAM/?p=classes. -->
  <edam_topics>
    <!-- Informatics -->
    <edam_topic>topic_0605</edam_topic>
    <!-- Bioinformatics -->
    <edam_topic>topic_0091</edam_topic>
    <!-- Sequence analysis -->
    <edam_topic>topic_0080</edam_topic>
  </edam_topics>

  <!-- Instead of describing what the tool is about, it describes what the
    tool does. -->
  <edam_operations>
    <!-- Sequence conversion -->
    <edam_operation>operation_0233</edam_operation>
  </edam_operations>

  <!-- Tells Galaxy what software or environment the tool needs to run.
    Also allows defining defaults for resources that are used if the user
    doesn't touch anything. -->
  <requirements>
    <container type="docker">
      quay.io/biocontainers/gawk:5.1.0--2
    </container>
  </requirements>

  <!-- Specifies how Galaxy should determine the version of your tool at
    runtime. -->
  <version_command>
    gawk -V
  </version_command>

  <!-- Specifies how Galaxy should invoke the tool’s executable, passing
    its required input parameter values (the command line specification
    links the parameters supplied in the form with the actual tool
    executable). -->
  <command detect_errors="aggressive" interpreter="bash"><![CDATA[
    ## Every read takes four lines: keep the header (with > instead of @)
    ## and the sequence, and drop the separator and quality lines.
    gawk
      --sandbox
      'NR % 4 == 1 {sub(/^@/, ">"); print} NR % 4 == 2 {print}'
      '$input_files.query'
      > '$output'
  ]]></command>

  <!-- Specifies which inputs Galaxy should allow users to specify. -->
  <inputs>
    <!-- Input Files -->
    <section
      name="input_files"
      title="Input Files"
      expanded="true"
    >
      <param
        name="query"
        type="data"
        format="fastq"
        label="FASTQ file"
        help="Reads to convert. Select a list collection to convert every
          file in it"
      />
    </section>
  </inputs>

  <!-- Defines what outputs the software will produce. -->
  <outputs>
    <data
      name="output"
      format="fasta"
      label="${tool.name} ${on_string} ${input_files.query.name} (FASTA)"
    />
  </outputs>

  <!-- Includes additional informative text for the user. -->
  <help>
    .. class:: infomark
    See GAWK documentation: https://www.gnu.org/software/gawk/manual/ for
    full software details.

    **What it does**
    Converts a FASTQ file to a FASTA file. The @ at the start of every
    header becomes a >, and the separator and quality lines are dropped.

    Select a list collection to convert every file in it. Galaxy runs the
    tool once for every file and returns a list of FASTA files.

    .. class:: warningmark
    Every read must take up exactly four lines. Wrapped sequence or quality
    lines are not supported.
  </help>

  <!-- Allows for citing the published article or reference of the software
    being used. -->
  <citations>
    <citation type="doi">10.1002/spe.4380090403</citation>
  </citations>
</tool>