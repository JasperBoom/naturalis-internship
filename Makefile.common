# -----------------------------
# Variables
# -----------------------------
SHELL := /bin/bash
BLACK_PYTHON_VERSION ?= py38

# -----------------------------
# Helper targets
# -----------------------------
.PHONY: help
help: ## Show this help page.
	@echo "Available targets:"
	@grep -hE '^[a-zA-Z0-9_-]+:.*?##' ${MAKEFILE_LIST} | \
		awk -F':.*?##' '{ \
			printf "\033[38;2;67;176;42m  make %-22s\033[0m - " \
				"\033[38;2;108;172;228m%s\033[0m\n", $$1, $$2 \
		}' | sort

# -----------------------------
# Docker targets
# -----------------------------
.PHONY: list-containers
list-containers: ## List all containers (running + stopped).
	@echo "List all containers..."
	@docker ps -a

.PHONY: list-images
list-images: ## List all images.
	@echo "List all images..."
	@docker images

.PHONY: list-volumes
list-volumes: ## List all volumes.
	@echo "List all volumes..."
	@docker volume ls

.PHONY: list-networks
list-networks: ## List networks.
	@echo "List all networks..."
	@docker network ls

# -----------------------------
# Black formatter targets
# -----------------------------
.PHONY: black
black: ## Run black formatter on repository Python files.
	@echo "Running black formatter on Python files..."
	@apptainer exec \
		--containall \
		--bind ${PWD}:/src \
		docker://${BLACK_IMG}:${BLACK_IMG_TAG} \
		black \
			--line-length 79 \
			--target-version ${BLACK_PYTHON_VERSION} \
			/src

# -----------------------------
# Miscellaneous targets
# -----------------------------
.PHONY: clean-pycache
clean-pycache: ## Remove all __pycache__ directories recursively.
	@echo "Removing __pycache__ directories..."
	@find . -type d -name __pycache__ -exec sudo rm -rf {} +